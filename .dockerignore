# Deny the complete build context, then allow only files copied by Dockerfile.
**
!requirements.txt
!pyproject.toml
!Dockerfile
!docker-compose.yml
!app/
!app/**
!tma/
!tma/**
!tests/
!tests/**
!scripts/
!scripts/**

# Keep sensitive/runtime artifacts after allow rules: Docker uses the last
# matching pattern, so this order also protects future nested files.
.git
.github
.agents
.codex
.venv
.pytest_cache
.pytest-completion-temp
.ruff_cache
tmp
__pycache__
**/__pycache__
*.pyc
**/*.pyc

.env
.env.*
**/.env
**/.env.*
reminders.db
data
**/data
*.db
**/*.db
*.db-*
**/*.db-*
*.sqlite
**/*.sqlite
*.sqlite-*
**/*.sqlite-*
*.sqlite3
**/*.sqlite3
*.sqlite3-*
**/*.sqlite3-*
*-journal
**/*-journal
*-wal
**/*-wal
*-shm
**/*-shm
*.bak
**/*.bak
*.backup
**/*.backup
bot_backup_*.py
**/bot_backup_*.py
backup/
**/backup/
backups/
**/backups/
review-diff.txt
**/review-diff.txt

.DS_Store
**/.DS_Store
Thumbs.db
**/Thumbs.db
